# ---------------------------------------------------------------------------
# Togethr environment configuration.
# Copy this file to ".env" and fill in your own values. NEVER commit ".env".
# ---------------------------------------------------------------------------

# --- Django core ------------------------------------------------------------
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me-paste-a-long-random-string-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated, e.g. https://togethr.example.com  (needed behind HTTPS in production)
DJANGO_CSRF_TRUSTED_ORIGINS=
# Obscured URL for the built-in Django admin (must end with a slash)
DJANGO_ADMIN_URL=django-admin/
DJANGO_TIME_ZONE=Asia/Manila

# --- Database (MySQL / MariaDB, database name: togethr) ----------------------
DB_NAME=togethr
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Gmail SMTP ----------------------------------------------------------------
# 1. Turn on 2-Step Verification for the Gmail account.
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character app password below (NOT your normal Gmail password).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your.address@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
DEFAULT_FROM_EMAIL=Togethr <your.address@gmail.com>

# --- Security tuning (defaults shown) ----------------------------------------
VERIFICATION_CODE_TTL_MINUTES=10
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
VERIFICATION_MAX_SENDS_PER_HOUR=5
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_MAX_REQUESTS_PER_HOUR=5

# --- Production only ---------------------------------------------------------
# Set to True only when a trusted reverse proxy sets X-Forwarded-For / -Proto.
TRUST_PROXY_HEADERS=False
